# Copy this file to %USERPROFILE%\.usage-viewer\remote.env and edit as needed.
# Values here override the defaults in sync-codex-remote.ps1.
REMOTE_USER=jerry
REMOTE_HOST=192.168.2.57
POLL_SECONDS=10

# Optional. Leave empty to use the default SSH authentication.
SSH_KEY_PATH=
SSH_PORT=22

# Optional remote Codex sessions directory.
REMOTE_SESSIONS_PATH=~/.codex/sessions
