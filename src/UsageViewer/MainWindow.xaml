<Window x:Class="UsageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage Viewer" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
  <Border Background="#E8171717" BorderBrush="#666666" BorderThickness="1" CornerRadius="8" Padding="7,4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="MainText" Grid.Row="0" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,24,0" />
      <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
              Width="22" Height="22" Margin="0,-3,-3,0"
              Content="&#x00D7;" FontFamily="Segoe UI" FontSize="16"
              Foreground="#BBBBBB" Background="Transparent" BorderThickness="0"
              Cursor="Hand" ToolTip="Close" Click="OnCloseClick">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="CloseBackground" Background="{TemplateBinding Background}" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="CloseBackground" Property="Background" Value="#44FFFFFF" />
                      <Setter Property="Foreground" Value="White" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="CloseBackground" Property="Background" Value="#66FFFFFF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Button.Style>
      </Button>
      <TextBlock x:Name="DetailText" Grid.Row="1" Foreground="#BBBBBB" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
    </Grid>
  </Border>
</Window>
