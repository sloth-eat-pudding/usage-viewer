<Window x:Class="UsageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage Viewer" MinWidth="340" MaxWidth="900" SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" Typography.NumeralAlignment="Tabular"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
  <Border x:Name="OverlayBorder" Background="#F0181818" BorderBrush="#4AFFFFFF"
          BorderThickness="1" CornerRadius="10" Padding="8,6">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- Stacked layout: every group on its own line, details below. -->
      <StackPanel x:Name="StackedPanel" Grid.Column="0" Cursor="SizeAll">
        <TextBlock x:Name="MainText" Foreground="White" FontSize="14"
                   FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailText" Foreground="#B7B7B7" FontSize="11"
                   Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <!-- Column layout: one column per group, usage above its details. -->
      <StackPanel x:Name="ColumnsPanel" Grid.Column="0" Orientation="Horizontal"
                  Cursor="SizeAll" Visibility="Collapsed" />
      <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button x:Name="PinButton" Width="24" Height="22" Content="P"
                Foreground="#C8C8C8" Background="Transparent" BorderThickness="0"
                Cursor="Hand" ToolTip="Pin" Click="OnPinClick" />
        <Button x:Name="CloseButton" Grid.Column="1" Width="24" Height="22" Content="&#x00D7;"
                FontFamily="Segoe UI" FontSize="16" Foreground="#C8C8C8" Background="Transparent"
                BorderThickness="0" Cursor="Hand" ToolTip="Close" Click="OnCloseClick" />
        <Button x:Name="SettingsButton" Grid.Row="1" MinWidth="24" Height="22" Padding="5,0" Content="S"
                Foreground="#C8C8C8" Background="Transparent" BorderThickness="0"
                Cursor="Hand" ToolTip="Settings" Click="OnSettingsClick" />
        <Button x:Name="ReapplyButton" Grid.Row="1" Grid.Column="1" Width="24" Height="22" Content="&#x21BB;"
                Foreground="#C8C8C8" Background="Transparent" BorderThickness="0"
                Cursor="Hand" ToolTip="重新套用 Claude 和 Codex 個人設定"
                AutomationProperties.Name="重新套用 Claude 和 Codex 個人設定" Click="OnReapplyClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
