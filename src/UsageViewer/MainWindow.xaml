<Window x:Class="UsageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage Viewer" Width="420" MinWidth="320" MaxWidth="520" SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
  <Border x:Name="OverlayBorder" Background="#F0181818" BorderBrush="#4AFFFFFF"
          BorderThickness="1" CornerRadius="10" Padding="8,6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="MainText" Grid.Column="0" Foreground="White" FontSize="14"
                   FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                   Cursor="SizeAll" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
          <Button x:Name="PinButton" Width="24" Height="22" Content="P"
                  Foreground="#C8C8C8" Background="Transparent" BorderThickness="0"
                  Cursor="Hand" ToolTip="Pin" Click="OnPinClick" />
          <Button x:Name="SettingsButton" MinWidth="58" Height="22" Padding="5,0" Content="Settings"
                  Foreground="#C8C8C8" Background="Transparent" BorderThickness="0"
                  Cursor="Hand" ToolTip="Settings" Click="OnSettingsClick" />
          <Button x:Name="CloseButton" Width="24" Height="22" Content="&#x00D7;"
                  FontFamily="Segoe UI" FontSize="16" Foreground="#C8C8C8"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  ToolTip="Close" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="DetailText" Grid.Row="1" Foreground="#B7B7B7" FontSize="11"
                 Margin="0,4,0,0" TextWrapping="Wrap"
                 Cursor="SizeAll" />
    </Grid>
  </Border>
</Window>
