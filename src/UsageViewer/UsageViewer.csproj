<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>usage-viewer.ico</ApplicationIcon>
    <AssemblyName>UsageViewer</AssemblyName>
    <RootNamespace>UsageViewer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="usage-viewer.ico" />
    <EmbeddedResource Include="..\..\scripts\claude-desktop-profiles.ps1" LogicalName="UsageViewer.ClaudeDesktopProfiles.ps1" />
    <EmbeddedResource Include="..\..\scripts\claude-desktop-usage-injector.ps1" LogicalName="UsageViewer.ClaudeDesktopUsageInjector.ps1" />
    <EmbeddedResource Include="..\desktop-addon\claude-session-meter.js" LogicalName="UsageViewer.ClaudeSessionMeter.js" />
    <EmbeddedResource Include="..\..\scripts\create-codex-account-profile.ps1" LogicalName="UsageViewer.CreateCodexAccountProfile.ps1" />
    <EmbeddedResource Include="..\..\scripts\codex-account-registry.ps1" LogicalName="UsageViewer.CodexAccountRegistry.ps1" />
    <EmbeddedResource Include="..\..\scripts\start-codex-account-profile.ps1" LogicalName="UsageViewer.StartCodexAccountProfile.ps1" />
    <EmbeddedResource Include="..\..\scripts\start-codex-native-meter.ps1" LogicalName="UsageViewer.StartCodexNativeMeter.ps1" />
    <EmbeddedResource Include="..\..\scripts\codex-native-meter.cjs" LogicalName="UsageViewer.CodexNativeDriver.cjs" />
    <EmbeddedResource Include="..\..\scripts\codex-profile-metrics.cjs" LogicalName="UsageViewer.CodexProfileMetrics.cjs" />
    <EmbeddedResource Include="..\..\scripts\codex-desktop-usage.cjs" LogicalName="UsageViewer.CodexDesktopUsage.cjs" />
    <EmbeddedResource Include="..\..\scripts\watch-codex-desktop-usage.ps1" LogicalName="UsageViewer.WatchCodexDesktopUsage.ps1" />
    <EmbeddedResource Include="..\desktop-addon\codex-native-meter.js" LogicalName="UsageViewer.CodexNativeMeter.js" />
    <None Include="..\..\scripts\sync-codex-remote.ps1" Link="scripts\sync-codex-remote.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
