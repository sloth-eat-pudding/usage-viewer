<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Run against the shipping .NET Framework 4.8 on Windows; elsewhere use modern .NET. -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net48</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- Exercise production components without WPF or test packages. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/UsageViewer/Compat/*.cs" Link="Compat/%(Filename)%(Extension)" />
    <Compile Include="../../src/UsageViewer/Storage/*.cs" Link="Storage/%(Filename)%(Extension)" />
    <Compile Include="../../src/UsageViewer/Readers/*.cs" Link="Readers/%(Filename)%(Extension)" />
    <Compile Include="../../src/UsageViewer/Integration/ClaudeUsageContract.cs" Link="ClaudeUsageContract.cs" />
    <Compile Include="../../src/UsageViewer/Integration/SessionMeterHeartbeat.cs" Link="SessionMeterHeartbeat.cs" />
    <Compile Include="../../src/UsageViewer/Settings/DisplaySettings.cs" Link="DisplaySettings.cs" />
    <Compile Include="../../src/UsageViewer/Settings/DisplayGroups.cs" Link="DisplayGroups.cs" />
    <Compile Include="../../src/UsageViewer/Settings/DisplaySettingsStore.cs" Link="DisplaySettingsStore.cs" />
    <None Include="../fixtures/claude-usage.json" Link="claude-usage.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
