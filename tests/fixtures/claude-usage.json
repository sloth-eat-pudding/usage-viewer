[
  {
    "name": "legacy zero usage and exact resets",
    "input": { "five_hour": { "utilization": 0, "resets_at": "2030-01-01T00:00:00Z" }, "seven_day": { "utilization": 78, "resets_at": "2030-01-08T00:00:00Z" } },
    "expected": { "five_hour_used": 0, "seven_day_used": 78, "five_hour_epoch_seconds": 1893456000, "seven_day_epoch_seconds": 1894060800 }
  },
  {
    "name": "canonical limits",
    "input": { "limits": [{ "kind": "session", "percent": 25.5 }, { "kind": "weekly_all", "percent": 100 }] },
    "expected": { "five_hour_used": 25.5, "seven_day_used": 100, "five_hour_epoch_seconds": null, "seven_day_epoch_seconds": null }
  },
  {
    "name": "canonical values override legacy independently",
    "input": { "five_hour": { "utilization": 20, "resets_at": "2030-01-01T00:00:00Z" }, "limits": [{ "kind": "session", "percent": 0, "resets_at": "invalid" }] },
    "expected": { "five_hour_used": 0, "seven_day_used": null, "five_hour_epoch_seconds": 1893456000, "seven_day_epoch_seconds": null }
  },
  {
    "name": "invalid canonical percentage falls back to legacy",
    "input": { "five_hour": { "utilization": 20 }, "limits": [{ "kind": "session", "percent": 101, "resets_at": "2030-01-01T00:00:00Z" }] },
    "expected": { "five_hour_used": 20, "seven_day_used": null, "five_hour_epoch_seconds": 1893456000, "seven_day_epoch_seconds": null }
  },
  {
    "name": "numeric strings remain compatible",
    "input": { "five_hour": { "utilization": " 12.5 " } },
    "expected": { "five_hour_used": 12.5, "seven_day_used": null, "five_hour_epoch_seconds": null, "seven_day_epoch_seconds": null }
  },
  { "name": "empty object", "input": {}, "invalid": true },
  { "name": "null response", "input": null, "invalid": true },
  { "name": "empty percentage", "input": { "five_hour": { "utilization": " " } }, "invalid": true },
  { "name": "boolean percentage", "input": { "five_hour": { "utilization": false } }, "invalid": true },
  { "name": "negative percentage", "input": { "five_hour": { "utilization": -1 } }, "invalid": true },
  { "name": "percentage over 100", "input": { "five_hour": { "utilization": 101 } }, "invalid": true },
  { "name": "unrelated limit", "input": { "limits": [null, { "kind": "weekly_other", "percent": 20 }] }, "invalid": true }
]
